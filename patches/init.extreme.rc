# ═══════════════════════════════════════════════════════════════
#  PROJECT EXTREME++ | Maintainer: PandeyJI-9
#  Native Init & Schedtune Hardware Rules | HyperOS ONLY
#  POCO F4 (munch / SM8250-AC Kona) | Android 13-17
# ═══════════════════════════════════════════════════════════════

on early-init
    # Disable I/O accounting stats overhead early in boot
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/sda/queue/iostats 0
    write /sys/block/sdb/queue/iostats 0
    write /sys/block/sdc/queue/iostats 0

on init
    # ── 1. Dynamic Task Weighting (Schedtune Baseline) ──
    # Increase perceived load for top-app (games/active app) without locking frequencies
    # CRITICAL FIX FOR HYPEROS 4 / ANDROID 17: prefer_idle = 1 forces immediate dispatch to idle Big/Prime cores!
    write /dev/stune/top-app/schedtune.boost 15
    write /dev/stune/top-app/schedtune.prefer_idle 1
    write /dev/stune/foreground/schedtune.boost 5
    write /dev/stune/foreground/schedtune.prefer_idle 1
    write /dev/stune/background/schedtune.boost 0
    write /dev/stune/background/schedtune.prefer_idle 0

    # Uclamp support if ROM/upstream kernel utilizes cpuctl uclamp
    write /dev/cpuctl/top-app/cpu.uclamp.min 15
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.uclamp.min 0

on boot
    # ── 2. iOS-Style QoS CPU Pinning & Core Isolation ──
    # Confine background sync/telemetry strictly to Little cores (0-3)
    # Keeps Gold (4-6) & Prime (7) L1/L2 caches unpolluted for games & active UI apps
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/restricted/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/top-app/cpus 0-7

    # ── 3. Smooth WALT Migration (Zero Silver Choke) ──
    write /proc/sys/kernel/sched_upmigrate "65 80"
    write /proc/sys/kernel/sched_downmigrate "50 65"
    write /proc/sys/kernel/sched_group_upmigrate 70
    write /proc/sys/kernel/sched_group_downmigrate 55

    # iPhone-Grade Frame Pacing: 500us ramp-up and 20ms hold window
    write /sys/devices/system/cpu/cpufreq/policy0/extreme+/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/extreme+/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy4/extreme+/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/extreme+/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/extreme+/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/extreme+/down_rate_limit_us 20000

    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 20000

    # Anti-Flicker: Little cluster floor at 576MHz prevents DSI mode-switch flicker during YouTube 120Hz<->60Hz switching
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 576000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 710400
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 844800

    # Power Efficient Workqueues (Sleep & Battery Optimization)
    write /sys/module/workqueue/parameters/power_efficient Y

on property:sys.boot_completed=1
    # ── 4. Post-Boot Final Enforcement (Survives ROM Resets) ──
    write /proc/sys/kernel/sched_upmigrate "65 80"
    write /proc/sys/kernel/sched_downmigrate "50 65"
    write /proc/sys/kernel/sched_group_upmigrate 70
    write /proc/sys/kernel/sched_group_downmigrate 55

    write /dev/stune/top-app/schedtune.boost 15
    write /dev/stune/top-app/schedtune.prefer_idle 1
    write /dev/stune/foreground/schedtune.prefer_idle 1

    # Network: TCP BBR Congestion Control & Low Latency
    write /proc/sys/net/ipv4/tcp_congestion_control bbr
    write /proc/sys/net/ipv4/tcp_low_latency 1
    write /proc/sys/net/ipv4/tcp_tw_reuse 1
    write /proc/sys/net/ipv4/tcp_fastopen 3

    # VM & ZRAM optimization (Instant App Opening & Smooth Multitasking on 6GB RAM)
    # HyperOS 4 / Android 17 tuned: Swappiness = 100 protects executable DEX/ODEX page cache
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 50
    write /proc/sys/vm/dirty_ratio 15
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/watermark_scale_factor 16
    write /proc/sys/vm/extra_free_kbytes 40960
    write /proc/sys/vm/page-cluster 0
